{
 "slug": "translation-token-audit",
 "module": "translation-token-audit/src/audit",
 "function": "audit",
 "cases": [
  {
   "name": "Named brace token passes",
   "args": [
    "Hello {name}.",
    "Bonjour {name}."
   ],
   "expected": {
    "sourceLines": 1,
    "targetLines": 1,
    "error": "",
    "lines": [
     {
      "line": 1,
      "status": "pass",
      "missing": [],
      "added": [],
      "orderMismatch": false,
      "unsupported": [],
      "sourceTokens": [
       "{name}"
      ],
      "targetTokens": [
       "{name}"
      ]
     }
    ]
   }
  },
  {
   "name": "Renamed brace reports missing and added",
   "args": [
    "{name}",
    "{names}"
   ],
   "expected": {
