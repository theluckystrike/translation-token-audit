    "targetLines": 1,
    "error": "",
    "lines": [
     {
      "line": 1,
      "status": "mismatch",
      "missing": [
       {
        "token": "{name}",
        "count": 1
       }
      ],
      "added": [
       {
        "token": "{names}",
        "count": 1
       }
      ],
      "orderMismatch": false,
      "unsupported": [],
      "sourceTokens": [
       "{name}"
      ],
      "targetTokens": [
       "{names}"
      ]
     }
    ]
   }
  },
